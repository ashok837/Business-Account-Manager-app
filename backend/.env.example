# Rename this file to .env before running the app

# Environment: "development" or "production". In production, the app
# refuses to start with the default SECRET_KEY below.
ENVIRONMENT=development

# Secret key used to sign JWT tokens. Generate your own with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret_key

# JWT algorithm
ALGORITHM=HS256

# Access token lifetime (short-lived; the frontend silently refreshes it)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime (how long a user stays logged in without re-entering
# their password)
REFRESH_TOKEN_EXPIRE_DAYS=14

# Account lockout after repeated failed logins (brute-force mitigation)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed frontend URL here in production.
ALLOWED_ORIGINS=http://localhost:5173

# Database URL - SQLite for local development.
DATABASE_URL=sqlite:///./smb.db
# For MySQL (self-hosted or AWS RDS), use instead:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>

# --- Chatbot (optional) ---
# The built-in assistant answers common questions from your data with no key.
# Add an Anthropic API key to let it also answer free-form questions with Claude.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
